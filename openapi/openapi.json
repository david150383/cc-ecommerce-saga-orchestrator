{
  "openapi": "3.1.0",
  "info": {
    "title": "Saga Orchestrator",
    "version": "1.0.0",
    "description": "Checkout saga. Workflow: docs/saga.md"
  },
  "servers": [
    {
      "url": "http://localhost:4007"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CheckoutStatus": {
        "type": "object",
        "properties": {
          "sagaId": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PROCESSING",
              "AWAITING_PAYMENT",
              "COMPLETED",
              "CANCELLED",
              "FAILED",
              "UNDER_REVIEW"
            ]
          },
          "checkoutUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present only while AWAITING_PAYMENT"
          },
          "failureReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "statusUrl": {
            "type": "string"
          }
        },
        "required": [
          "sagaId",
          "orderId",
          "status",
          "checkoutUrl",
          "failureReason",
          "statusUrl"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance"
        ],
        "additionalProperties": {}
      },
      "CheckoutRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              },
              "required": [
                "sku",
                "quantity"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "shippingAddress": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "line1": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "line2": {
                "type": "string",
                "maxLength": 200
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "state": {
                "type": "string",
                "maxLength": 100
              },
              "postalCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "phone": {
                "type": "string",
                "pattern": "^\\+[1-9][0-9]{6,14}$"
              }
            },
            "required": [
              "name",
              "line1",
              "city",
              "postalCode",
              "country",
              "phone"
            ],
            "additionalProperties": false
          },
          "couponCode": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "items",
          "currency",
          "shippingAddress"
        ],
        "additionalProperties": false,
        "description": "Prices and totals are never accepted from the browser."
      },
      "AdminSaga": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "STARTED",
              "RESERVING_INVENTORY",
              "INVENTORY_RESERVED",
              "AWAITING_PAYMENT",
              "CONFIRMING_INVENTORY",
              "CONFIRMING_ORDER",
              "COMPLETED",
              "CANCELLING",
              "REFUNDING",
              "CANCELLED",
              "FAILED",
              "MANUAL_REVIEW",
              "RESOLVED"
            ]
          },
          "orderId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "reservationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "paymentId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "total": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "amountMinor": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              }
            },
            "required": [
              "amountMinor",
              "currency"
            ]
          },
          "failureReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "compensation": {
            "type": "object",
            "additionalProperties": {}
          },
          "stepAttempts": {
            "type": "integer"
          },
          "deadlineAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "version": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "customerId",
          "state",
          "orderId",
          "reservationId",
          "paymentId",
          "total",
          "failureReason",
          "compensation",
          "stepAttempts",
          "deadlineAt",
          "version",
          "createdAt",
          "updatedAt",
          "completedAt"
        ]
      },
      "ResolveRequest": {
        "type": "object",
        "properties": {
          "resolution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/checkout": {
      "post": {
        "tags": [
          "checkout"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Start a checkout (202: continues asynchronously; poll statusUrl)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted (Idempotency-Replayed: true for a repeated key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutStatus"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED / IDEMPOTENCY_KEY_REQUIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "IDEMPOTENCY_KEY_REUSED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/checkout/{sagaId}": {
      "get": {
        "tags": [
          "checkout"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Checkout progress (owner or admin)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sagaId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutStatus"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/sagas": {
      "get": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List sagas, e.g. ?state=MANUAL_REVIEW",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "STARTED",
                "RESERVING_INVENTORY",
                "INVENTORY_RESERVED",
                "AWAITING_PAYMENT",
                "CONFIRMING_INVENTORY",
                "CONFIRMING_ORDER",
                "COMPLETED",
                "CANCELLING",
                "REFUNDING",
                "CANCELLED",
                "FAILED",
                "MANUAL_REVIEW",
                "RESOLVED"
              ]
            },
            "required": false,
            "name": "state",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Sagas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdminSaga"
                      }
                    },
                    "page": {
                      "type": "object",
                      "properties": {
                        "limit": {
                          "type": "integer"
                        },
                        "nextCursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "limit",
                        "nextCursor"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "page"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/sagas/{sagaId}": {
      "get": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Saga with its full step history",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sagaId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Saga",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saga": {
                      "$ref": "#/components/schemas/AdminSaga"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "saga",
                    "steps"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/sagas/{sagaId}/retry": {
      "post": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Make the current step due now",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sagaId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Scheduled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saga": {
                      "$ref": "#/components/schemas/AdminSaga"
                    }
                  },
                  "required": [
                    "saga"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "NOT_RETRYABLE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/sagas/{sagaId}/resolve": {
      "post": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Close a MANUAL_REVIEW saga",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sagaId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saga": {
                      "$ref": "#/components/schemas/AdminSaga"
                    }
                  },
                  "required": [
                    "saga"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "NOT_IN_MANUAL_REVIEW",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}

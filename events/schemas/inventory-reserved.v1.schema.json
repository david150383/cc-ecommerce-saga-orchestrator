{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ecommerce.local/inventory-service/inventory-reserved.v1.schema.json",
  "title": "InventoryReserved v1",
  "description": "Stock for every line is held until expiresAt.",
  "x-message-kind": "event",
  "x-producer": "ecommerce-inventory-service",
  "x-consumers": [
    "ecommerce-saga-orchestrator"
  ],
  "x-channel": "SNS inventory-events",
  "$ref": "../common/envelope.v1.schema.json",
  "properties": {
    "messageKind": {
      "const": "event"
    },
    "messageType": {
      "const": "InventoryReserved"
    },
    "messageVersion": {
      "const": 1
    },
    "producer": {
      "const": "ecommerce-inventory-service"
    },
    "payload": {
      "type": "object",
      "required": [
        "reservationId",
        "orderId",
        "lines",
        "expiresAt"
      ],
      "additionalProperties": false,
      "properties": {
        "reservationId": {
          "type": "string",
          "format": "uuid"
        },
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "sku",
              "quantity"
            ],
            "additionalProperties": false,
            "properties": {
              "sku": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    }
  }
}

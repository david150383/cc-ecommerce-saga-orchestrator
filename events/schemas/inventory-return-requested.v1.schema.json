{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ecommerce.local/inventory-service/inventory-return-requested.v1.schema.json",
  "title": "InventoryReturnRequested v1",
  "description": "Put the stock of a CONFIRMED reservation back on hand (the order was cancelled before it shipped).",
  "x-message-kind": "command",
  "x-producer": "ecommerce-saga-orchestrator",
  "x-consumers": [
    "ecommerce-inventory-service"
  ],
  "x-channel": "SQS inventory-commands",
  "$ref": "../common/envelope.v1.schema.json",
  "properties": {
    "messageKind": {
      "const": "command"
    },
    "messageType": {
      "const": "InventoryReturnRequested"
    },
    "messageVersion": {
      "const": 1
    },
    "producer": {
      "const": "ecommerce-saga-orchestrator"
    },
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "reservationId",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "reservationId": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "enum": [
            "ORDER_CANCELLED"
          ]
        }
      }
    }
  }
}

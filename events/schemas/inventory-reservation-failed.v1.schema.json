{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ecommerce.local/inventory-service/inventory-reservation-failed.v1.schema.json",
  "title": "InventoryReservationFailed v1",
  "description": "Nothing was reserved (all-or-nothing).",
  "x-message-kind": "event",
  "x-producer": "ecommerce-inventory-service",
  "x-consumers": [
    "ecommerce-saga-orchestrator"
  ],
  "x-channel": "SNS inventory-events",
  "$ref": "../common/envelope.v1.schema.json",
  "properties": {
    "messageKind": {
      "const": "event"
    },
    "messageType": {
      "const": "InventoryReservationFailed"
    },
    "messageVersion": {
      "const": 1
    },
    "producer": {
      "const": "ecommerce-inventory-service"
    },
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "reason",
        "unavailableLines"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "enum": [
            "INSUFFICIENT_STOCK",
            "UNKNOWN_SKU",
            "RESERVATION_EXPIRED",
            "INVALID_REQUEST"
          ]
        },
        "unavailableLines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sku",
              "requested",
              "available"
            ],
            "additionalProperties": false,
            "properties": {
              "sku": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"
              },
              "requested": {
                "type": "integer",
                "minimum": 1
              },
              "available": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}

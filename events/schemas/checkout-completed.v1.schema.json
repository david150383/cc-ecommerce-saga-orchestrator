{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ecommerce.local/saga-orchestrator/checkout-completed.v1.schema.json",
  "title": "CheckoutCompleted v1",
  "description": "The checkout saga reached COMPLETED.",
  "x-message-kind": "event",

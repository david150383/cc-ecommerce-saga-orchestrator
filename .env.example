NODE_ENV=development
PORT=4007
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000

# Shared local stack (ecommerce-infrastructure):
DATABASE_URL=postgresql://saga_svc:saga_local_pw@localhost:5432/saga_db
# Standalone (this repo: docker compose up -d):
# DATABASE_URL=postgresql://saga_svc:saga_local_pw@localhost:5447/saga_db
TEST_DATABASE_URL=postgresql://saga_svc:saga_local_pw@localhost:5432/saga_test

# Incoming tokens
JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ISSUER=ecommerce-auth-service
JWT_AUDIENCE=ecommerce-api
JWT_SERVICE_AUDIENCE=ecommerce-saga-orchestrator

# Synchronous calls (client-credentials tokens from Auth)
AUTH_SERVICE_URL=http://localhost:4001
SERVICE_CLIENT_ID=ecommerce-saga-orchestrator
SERVICE_CLIENT_SECRET=saga-orchestrator-local-secret   # LOCAL ONLY
ORDER_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
FRONTEND_BASE_URL=http://localhost:5173
DEPENDENCY_TIMEOUT_MS=5000

# Messaging (Floci locally)
MESSAGING_ENABLED=true
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SAGA_INBOX_QUEUE_NAME=local-ecommerce-saga-inbox
INVENTORY_COMMANDS_QUEUE_NAME=local-ecommerce-inventory-commands
ORDER_COMMANDS_QUEUE_NAME=local-ecommerce-order-commands.fifo
PAYMENT_COMMANDS_QUEUE_NAME=local-ecommerce-payment-commands
SAGA_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:local-ecommerce-saga-events
OUTBOX_POLL_INTERVAL_MS=500
CONSUMER_WAIT_TIME_SECONDS=20
TEST_AWS_ENDPOINT_URL=http://localhost:4566

# Saga policy
RESERVATION_TIMEOUT_SECONDS=30
PAYMENT_TIMEOUT_SECONDS=1800
STEP_TIMEOUT_SECONDS=30
MAX_STEP_ATTEMPTS=5
TIMER_INTERVAL_MS=1000
